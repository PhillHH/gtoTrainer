# Vorlage fuer .env - kopieren und Platzhalter ersetzen:
#   cp .env.example .env
# Die echte .env ist git-ignoriert und gehoert NIE ins Repository.

# --- Postgres-Container (docker-compose.yml) -------------------------------
POSTGRES_USER=gto
POSTGRES_PASSWORD=__SET_A_STRONG_PASSWORD__
POSTGRES_DB=gto

# Host-Port des Postgres-Containers. NICHT 5432 verwenden - der Port ist auf
# dem Zielhost bereits von einer fremden Instanz belegt. Vor dem Start pruefen:
#   ss -ltn | grep 55434
POSTGRES_HOST_PORT=55434

# --- Backend-Verbindung ----------------------------------------------------
# Muss zu den Werten oben passen. Host/Port sind die HOST-seitigen Werte,
# weil das Backend in T1.2 noch ausserhalb von Compose laeuft.
DATABASE_URL=postgres://gto:__SET_A_STRONG_PASSWORD__@127.0.0.1:55434/gto

# Separate Datenbank fuer Integrationstests auf derselben Instanz.
# Wird von den Tests bei Bedarf automatisch angelegt und migriert.
TEST_DATABASE_URL=postgres://gto:__SET_A_STRONG_PASSWORD__@127.0.0.1:55434/gto_test

# --- Backend-Laufzeit (lokal, ohne Container) ------------------------------
# Backend-Port fuer `pnpm --filter @gto/backend dev`. 3000 UND 3001 sind auf
# dem Zielhost fremd belegt - vor dem Start pruefen: ss -ltn | grep 3010
PORT=3010
HOST=0.0.0.0

# --- Deployment (docker-compose.yml, AP1.T1.5) -----------------------------
# Host-Port des Backend-Containers, an 127.0.0.1 gebunden. Der Host-Nginx
# proxyt hierhin. NICHT 3000/3001 - beide sind fremd belegt.
# Pruefen: ss -ltn | grep 3010
BACKEND_HOST_PORT=3010

# Verzeichnis, aus dem der Host-Nginx die gebauten Frontend-Assets ausliefert.
# Liegt bewusst AUSSERHALB des Repos und wird vom Deploy-Skript befuellt.
FRONTEND_STATIC_DIR=/home/phillip/gto-static

# Domain des Deployments (nur fuer Doku/Skripte).
DEPLOY_DOMAIN=gto.growento.com

# Zielverzeichnis der Backups - ausserhalb des Repos, wird nicht versioniert.
BACKUP_DIR=/home/phillip/gto-backups
# Wie viele Sicherungen aufgehoben werden.
BACKUP_KEEP=14

# --- Frontend (Dev-Server) -------------------------------------------------
# Vite-Port; 5173 ist auf dem Zielhost fremd belegt.
FRONTEND_PORT=5174
# Ziel des /api- und /healthz-Proxys im Dev-Server. Muss zu PORT passen.
BACKEND_URL=http://127.0.0.1:3010

# --- Seed (optional) -------------------------------------------------------
# Legt beim `pnpm db:seed` einen initialen Benutzer an, WENN beide Variablen
# gesetzt sind. Es wird bewusst nur ein fertiger Hash akzeptiert - das Erzeugen
# des Hashes (argon2) und das Passwort-CLI kommen in AP1.T1.3.
# SEED_USER_USERNAME=admin
# SEED_USER_PASSWORD_HASH=

# --- Auth / Session (AP1.T1.3) ---------------------------------------------
# Lebensdauer einer Session in Stunden.
SESSION_TTL_HOURS=168

# Secure-Flag der Cookies. Lokal ohne HTTPS MUSS das false sein, sonst
# verwirft der Browser das Cookie. Im TLS-Betrieb hinter dem Host-Nginx auf
# true - der Container-Default in docker-compose.yml ist deshalb bereits true.
# Ohne Angabe: true, wenn NODE_ENV=production, sonst false.
COOKIE_SECURE=false

# SameSite-Attribut: lax (Default) oder strict.
COOKIE_SAMESITE=lax

# Kommaseparierte Allowlist erlaubter Herkuenfte fuer zustandsaendernde
# Requests. Leer = keine Origin-Pruefung (lokale Entwicklung).
# Im TLS-Betrieb setzen:
# ALLOWED_ORIGINS=https://gto.growento.com

# Login-Rate-Limit: erlaubte FEHLversuche je Zeitfenster.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# TOTP-Hook. In T1.3 ist nur die Einhaengestelle vorbereitet - eine
# vollstaendige TOTP-Pruefung gibt es noch nicht. Default aus.
TOTP_ENABLED=false

# Nur fuer `pnpm auth:set-password`: Passwort per Variable statt interaktiv.
# Niemals dauerhaft in der .env stehen lassen.
# NEW_PASSWORD=

# --- Schutz fuer db:reset --------------------------------------------------
# `pnpm db:reset` loescht das komplette Schema. Es laeuft nur, wenn hier
# exakt "yes" steht UND NODE_ENV nicht auf "production" steht.
DB_RESET_CONFIRM=no

# --- Docker-Netzwerk ---------------------------------------------------------
# Freies Subnetz fuer das Compose-Netzwerk (siehe ADR-0006). Nur aendern, wenn
# 10.89.0.0/24 auf dem Zielhost belegt ist - pruefen mit: ip route
DOCKER_SUBNET=10.89.0.0/24

# --- LLM-Gateway (AP2) ------------------------------------------------------
# PFLICHT. Config-Verzeichnis der Claude CLI. Dieses Projekt nutzt
# ausschliesslich Profil B. Das Default-Profil /home/phillip/.claude wird
# weder gelesen noch veraendert; ein stiller Rueckfall darauf ist verboten -
# fehlt oder stimmt der Wert nicht, bricht der Adapter mit klarer Meldung ab
# (siehe ADR-0021). Wird beim CLI-Aufruf explizit ins Prozess-Environment
# gesetzt, nicht geerbt.
CLAUDE_CONFIG_DIR=/home/phillip/.claude-b

# Wie das Backend die CLI erreicht:
#   direct - dieser Prozess startet die CLI selbst (lokal, und im Runner)
#   socket - dieser Prozess spricht den Host-Runner an (Container)
# docker-compose.yml setzt fuer den Container fest "socket".
LLM_TRANSPORT=direct

# Verzeichnis mit dem Unix-Domain-Socket des Host-seitigen CLI-Runners
# (ADR-0022). Wird als einziges LLM-bezogenes Volume read-only in den
# Backend-Container gemountet; Profil B selbst wird NICHT gemountet.
# Der Runner wird auf dem HOST gestartet: pnpm llm:runner
LLM_RUNNER_SOCKET_DIR=/home/phillip/gto-llm-runner

# Ausfuehrbare Datei der Claude CLI (Suche ueber PATH, wenn nur der Name steht).
LLM_CLI_PATH=claude

# Arbeitsverzeichnis des CLI-Prozesses. Bewusst projektfremd: `claude -p` wuerde
# sonst CLAUDE.md, Hooks und MCP-Server aus dem Verzeichnis laden.
# Ohne Angabe: das temporaere Verzeichnis des Systems.
# LLM_CLI_CWD=/tmp

# Hoechstzahl gleichzeitiger CLI-Prozesse. AP3 setzt hunderte Aufrufe ab -
# ohne Begrenzung waere der Host ueberlastet (ADR-0023).
LLM_MAX_CONCURRENCY=2

# Retry: Gesamtzahl der Versuche und exponentieller Backoff mit Streuung.
# Wiederholt werden nur retrybare Kategorien (Timeout, RateLimit, Transient).
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=1000
LLM_RETRY_MAX_DELAY_MS=30000
LLM_RETRY_TOTAL_BUDGET_MS=300000

# Setzt die Live-Smoke-Tests beider Adapter frei (verbrauchen Kontingent bzw.
# Guthaben). Ohne ANTHROPIC_API_KEY wird der API-Teil sichtbar uebersprungen:
#   LLM_LIVE_SMOKE=true pnpm --filter @gto/backend exec vitest run test/llm/live-smoke.test.ts
LLM_LIVE_SMOKE=false

# Startwert fuer den aktiven Provider: cli (Claude-Subscription, primaer) oder
# api (Anthropic-Messages-API als Fallback). Die Laufzeitwahl steht in der
# config-Tabelle unter llm.provider und hat Vorrang - dieser Wert greift, wenn
# dort nichts hinterlegt ist. Umgeschaltet wird ohne Codeaenderung und ohne
# Neustart; die Oberflaeche dazu kommt in T2.6.
LLM_PROVIDER=cli

# Standardmodell. Alias (opus, sonnet, haiku) oder vollstaendige Modell-ID.
LLM_MODEL=claude-sonnet-5

# Timeout eines einzelnen LLM-Aufrufs in Millisekunden. Vision-Aufrufe aus AP3
# brauchen deutlich laenger als Textaufrufe, ebenso die Konzept-Extraktion aus
# T3.2 (~45 000 Zeichen Eingabe je Aufruf) - dort sind 600000 noetig.
# ACHTUNG: Der Host-Runner deckelt JEDEN Aufruf auf SEIN LLM_TIMEOUT_MS. Eine
# Erhoehung in der Datenbank oder hier wirkt erst, wenn der Runner mit
# demselben Wert NEU gestartet wurde (RUNBOOK 9.2 und 12.1).
LLM_TIMEOUT_MS=120000

# Ausgabegrenze der Claude CLI. Der Standard von 8192 Tokens reicht fuer
# laengere strukturierte Antworten nicht - die CLI bricht dann mit Kategorie
# invalid ab (nicht wiederholbar). Der Wert wirkt ueber die Umgebung des
# HOST-RUNNERS, nicht ueber den Container.
CLAUDE_CODE_MAX_OUTPUT_TOKENS=32000

# Nur fuer den API-Fallback (Adapter B). Platzhalter - der echte Schluessel
# gehoert in die git-ignorierte .env und NIE ins Repository. Der unveraenderte
# Platzhalter gilt als "nicht gesetzt": Ohne Schluessel startet das Backend
# normal weiter, solange cli der aktive Provider ist; wird api aktiv, bricht
# der Adapter mit einer klaren Meldung ab (Kategorie auth).
# Wichtig: Dem CLI-Prozess wird der Schluessel bewusst NICHT durchgereicht -
# sonst wuerde die CLI an der Subscription vorbei abrechnen (ADR-0023).
ANTHROPIC_API_KEY=__SET_ANTHROPIC_API_KEY__

# Abweichende Basis-URL der Anthropic-API. Normalerweise leer lassen; nur fuer
# einen Testserver oder ein Gateway noetig.
# ANTHROPIC_BASE_URL=

# Modell fuer die Live-Smoke-Tests. Bewusst klein - jeder Lauf kostet
# Kontingent bzw. Guthaben.
LLM_SMOKE_MODEL=claude-haiku-4-5

# --- Buchquellen (AP3) ------------------------------------------------------
# Verzeichnis der Buchquellen auf dem HOST. Wird read-only in den Container
# eingehaengt; der Chart-Job aus T3.3 liest die Bilder als Vision-Input.
# Standard ist ./data/book-source relativ zur Repo-Wurzel.
# BOOK_SOURCE_HOST_DIR=./data/book-source
#
# Absoluter Pfad IM Container bzw. fuer Prozesse ohne Repo-Wurzel. Compose
# setzt ihn selbst auf /app/data/book-source; auf dem Host bleibt er leer,
# dort wird die Repo-Wurzel gefunden.
# BOOK_SOURCE_DIR=

# --- Job-Worker und Aufruf-Protokoll (AP2.T2.5) -----------------------------
# Der Worker laeuft als Schleife IM Backend-Prozess (ADR-0026). Auf false
# gesetzt startet das Backend ohne Worker - Jobs bleiben dann liegen.
WORKER_ENABLED=true

# Wartezeit zwischen zwei Durchlaeufen, wenn die Queue leer war.
WORKER_POLL_INTERVAL_MS=2000

# Ab wann ein Job im Zustand "running" als verwaist gilt und erneut geholt
# werden darf (Worker abgestuerzt). MUSS deutlich ueber LLM_TIMEOUT_MS liegen,
# sonst wird ein langsamer Job doppelt verarbeitet (ADR-0027). Bei
# LLM_TIMEOUT_MS=600000 (T3.2) entsprechend auf 1200000 anheben.
WORKER_STALE_AFTER_MS=300000

# Obergrenze fuer Prompt und Antwort in llm_call_log. Bilder werden ohnehin nie
# im Klartext protokolliert, sondern als Kurzvermerk (ADR-0028).
LLM_LOG_MAX_CHARS=20000
