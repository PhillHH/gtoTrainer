{
  "name": "@gto/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify-Backend des GTO Trainers",
  "type": "module",
  "main": "./dist/server.js",
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli-migrate.ts",
    "db:seed": "tsx src/db/cli-seed.ts",
    "db:reset": "tsx src/db/cli-reset.ts",
    "auth:set-password": "tsx src/auth/cli-set-password.ts",
    "llm:runner": "tsx src/llm/runner-main.ts",
    "prompts:golden": "UPDATE_GOLDEN=1 vitest run test/prompts/golden.test.ts",
    "jobs:enqueue": "tsx src/jobs/cli-enqueue.ts",
    "book:import": "tsx src/book/cli-import.ts",
    "concepts:generate": "tsx src/concept/cli-generate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/cookie": "11.1.0",
    "@gto/shared": "workspace:*",
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
